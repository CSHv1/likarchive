# LinkedIn credentials
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Browser profile dir — run `python save_session.py` once to create this directory
# (used for headed local debugging; scraper.py reads STATE_PATH, not this dir)
BROWSER_PROFILE=browser_profile

# Portable auth state (Playwright storage_state export) — what scraper.py
# actually loads at runtime. Created by save_session.py alongside BROWSER_PROFILE.
STATE_PATH=auth_state.json

# Scraper config
DB_PATH=linkedin_likes.db
HEADLESS=false
SCROLL_PAUSE_MS=2000
MAX_POSTS=100

# Claude API (for tagger.py)
ANTHROPIC_API_KEY=your-key-here

# Cloud Run only (Phase 5+) — do not set these locally.
# K_SERVICE is set automatically by Cloud Run and toggles db_sync.py/cloud_auth.py.
# GCP_PROJECT=your-gcp-project-id
# GCS_BUCKET=likarchive-db
# AUTH_STATE_SECRET=linkedin-auth-state
