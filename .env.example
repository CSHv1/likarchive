# LinkedIn credentials
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Browser profile dir — run `python save_session.py` once to create this directory
# (used for headed local debugging; scraper.py reads STATE_PATH, not this dir)
BROWSER_PROFILE=browser_profile

# Portable auth state (Playwright storage_state export) — what scraper.py
# actually loads at runtime. Created by save_session.py alongside BROWSER_PROFILE.
STATE_PATH=auth_state.json

# Scraper config
DB_PATH=linkedin_likes.db
HEADLESS=false
SCROLL_PAUSE_MS=2000
MAX_POSTS=100

# Stop early once this many already-known posts show up in a row (saved posts
# come back newest-first, so this means "reached previously-synced content").
# Set to 0 to disable and always scroll until scrollHeight goes stale — use
# that for a deliberate full re-scan of the backlog.
MAX_CONSECUTIVE_SKIPPED=40

# Claude API (for tagger.py)
ANTHROPIC_API_KEY=your-key-here

# Clerk auth (for app.py / clerk_auth.py) — GUI only, active in every
# environment (not gated on K_SERVICE like the vars below).
# CLERK_PUBLISHABLE_KEY is client-visible by design, safe in this plain form.
# CLERK_SECRET_KEY lives here locally, and in Secret Manager (clerk-secret-key)
# in Cloud Run — same split as ANTHROPIC_API_KEY.
CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# Cloud Run only (Phase 5+) — do not set these locally.
# K_SERVICE is set automatically by Cloud Run and toggles db_sync.py/cloud_auth.py.
# GCP_PROJECT=your-gcp-project-id
# GCS_BUCKET=likarchive-db
# AUTH_STATE_SECRET=linkedin-auth-state
