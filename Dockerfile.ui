# Lightweight image for the GUI only (likarchive-ui) — no Playwright/Chromium,
# since app.py never touches a browser. Split out from the main Dockerfile
# (which stays Chromium-inclusive for the scraper) to cut image size/cold
# start/storage cost for the Cloud Run Service.
FROM python:3.11-slim

WORKDIR /app

COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt

# Explicit allowlist, not `COPY . .` — deliberately the opposite direction from
# the main Dockerfile's fix. There, the risk was under-inclusion (a new
# first-party module silently missing at runtime), so the fix was to default
# to including everything. Here the risk is the opposite: this image is
# supposed to stay small, so a new module should be an explicit, considered
# addition rather than something that silently bloats the GUI image back up.
COPY app.py db.py db_sync.py clerk_auth.py ./
COPY templates/ ./templates/
# ai_rag/ added deliberately for the "Ask Archive" feature (Phase 10) — a
# considered addition per the policy above, not swept in by default.
COPY ai_rag/ ./ai_rag/

ENV DB_PATH=/data/linkedin_likes.db

EXPOSE 8080

# --timeout 170: gunicorn's sync-worker default (30s) is shorter than a real
# /api/ask round trip (BigQuery retrieval + a non-streaming Claude call with
# web search can run 45-90s) — without this the worker gets SIGKILL'd mid-
# request well before Cloud Run's own 300s service timeout even comes into
# play. Kept comfortably under that 300s ceiling.
# --worker-class gthread --threads 8: /api/ask now streams (SSE), holding its
# connection open for the whole answer. With gunicorn's default single sync
# worker that would block every other request (post list, tags...) until the
# answer finished; threads let those keep being served alongside a stream.
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--timeout", "170", "--worker-class", "gthread", "--threads", "8", "app:app"]
